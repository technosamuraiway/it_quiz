{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.cjs",
      "use": "@vercel/node"
    },
    {
      "src": "src/**/*.{cjs,ts,jsx,tsx}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/questions",
      "dest": "/api/questions/index.cjs"
    },
    {
      "src": "/api/questions/(.*)",
      "dest": "/api/questions/[id].cjs"
    },
    {
      "src": "/api/categories",
      "dest": "/api/categories/index.cjs"
    }
  ]
}

