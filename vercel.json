{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.mjs",
      "use": "@vercel/node"
    },
    {
      "src": "src/**/*.{mjs,ts,jsx,tsx}",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/questions",
      "dest": "/api/questions/index.mjs"
    },
    {
      "src": "/api/questions/(.*)",
      "dest": "/api/questions/[id].mjs"
    },
    {
      "src": "/api/categories",
      "dest": "/api/categories/index.mjs"
    }
  ]
}

